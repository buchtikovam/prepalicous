{
	"name": "prepalicous",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"npm": "12.0.2",
		"node": "26.5.1"
	},
	"scripts": {
		"development:dev": "vite dev --force --mode development",
		"development:build": "vite build --mode development",
		"development:sync": "capacitor sync",
		"development:deploy": "npm run development:build & npm run development:sync",
		"development:publish": "",
		"production:dev": "vite dev --force --mode production",
		"production:build": "vite build --mode production",
		"production:sync": "capacitor sync",
		"production:deploy": "npm run production:build && npm run production:sync",
		"production:publish": "",
		"svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"eslint:fix": "eslint . --cache --cache-strategy content --cache-location ./node_modules/.cache/eslint/.eslintcache --no-warn-ignored --fix ",
		"eslint:check": "eslint . --cache --cache-strategy content --cache-location ./node_modules/.cache/eslint/.eslintcache --no-warn-ignored",
		"prettier:fix": "prettier --cache --cache-strategy content --write .",
		"prettier:check": "prettier --cache --cache-strategy content --check .",
		"code:fix": "npm run prettier:fix && npm run eslint:fix && npm run svelte:check",
		"code:check": "npm run prettier:check && npm run eslint:check && npm run svelte:check",
		"package:upgrade": "npx --yes npm-check-updates --upgrade",
		"prepare": "svelte-kit sync || echo ''"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"@fontsource-variable/inter": "^5.3.0",
		"@internationalized/date": "^3.12.4",
		"@lucide/svelte": "1.44.0",
		"@sveltejs/adapter-auto": "^7.0.1",
		"@sveltejs/kit": "^2.63.0",
		"@sveltejs/vite-plugin-svelte": "^7.1.2",
		"@tailwindcss/vite": "^4.3.0",
		"@types/node": "^24",
		"bits-ui": "^2.19.2",
		"clsx": "^2.1.1",
		"eslint": "^10.4.1",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-perfectionist": "5.11.0",
		"eslint-plugin-svelte": "^3.19.0",
		"globals": "^17.6.0",
		"prettier": "^3.8.3",
		"prettier-plugin-svelte": "^4.1.0",
		"prettier-plugin-tailwindcss": "^0.8.0",
		"shadcn-svelte": "^1.6.1",
		"svelte": "^5.56.1",
		"svelte-check": "^4.6.0",
		"tailwind-merge": "^3.6.0",
		"tailwind-variants": "^3.3.1",
		"tailwindcss": "^4.3.0",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.60.1",
		"vite": "^8.0.16"
	},
	"dependencies": {
		"@capacitor/android": "^8.5.1",
		"@capacitor/cli": "^8.5.1",
		"@capacitor/core": "^8.5.1",
		"@capacitor/device": "8.0.3",
		"@capacitor/ios": "^8.5.1",
		"@capacitor/splash-screen": "8.0.2",
		"@fontsource-variable/google-sans-flex": "5.3.1",
		"@sveltejs/adapter-static": "^3.0.10",
		"appwrite": "^27.0.0",
		"eslint-plugin-perfectionist": "5.11.0",
		"mode-watcher": "^1.1.0"
	}
}
