{
	"name": "prepalicious",
	"private": true,
	"version": "1.0.0",
	"type": "module",
	"engines": {
		"npm": "12.0.2",
		"node": "26.5.1"
	},
	"scripts": {
		"development:dev": "vite dev --force --mode development --host --port 5173",
		"development:build": "vite build --mode development",
		"development:deploy": "npm run development:build && npm run cap:sync",
		"production:dev": "vite dev --force --mode production",
		"production:build": "vite build --mode production",
		"production:deploy": "npm run production:build && npm run cap:sync",
		"cap:sync": "npx cap sync",
		"cap:android:open": "npx cap open android",
		"cap:android:run:dev": "npx cap run android --live-reload --port=5173",
		"cap:android:run": "npx cap run android",
		"cap:ios:open": "npx cap open ios",
		"preview": "vite preview",
		"svelte:check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
		"eslint:fix": "eslint . --cache --cache-strategy content --cache-location ./node_modules/.cache/eslint/.eslintcache --no-warn-ignored --fix ",
		"eslint:check": "eslint . --cache --cache-strategy content --cache-location ./node_modules/.cache/eslint/.eslintcache --no-warn-ignored",
		"prettier:fix": "prettier --cache --cache-strategy content --write .",
		"prettier:check": "prettier --cache --cache-strategy content --check .",
		"code:fix": "npm run prettier:fix && npm run eslint:fix && npm run svelte:check",
		"code:check": "npm run prettier:check && npm run eslint:check && npm run svelte:check",
		"package:upgrade": "npx --yes npm-check-updates --upgrade",
		"prepare": "svelte-kit sync || echo ''",
		"test:unit": "vitest --project server",
		"test:coverage": "vitest run --project server --coverage",
		"test:e2e": "playwright test",
		"test": "npm run test:unit -- --run && npm run test:e2e"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@fontsource-variable/inter": "5.3.0",
		"@internationalized/date": "3.12.4",
		"@lucide/svelte": "1.47.0",
		"@playwright/test": "1.63.0",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.3",
		"@sveltejs/vite-plugin-svelte": "7.3.0",
		"@tailwindcss/vite": "4.3.3",
		"@types/node": "24.13.6",
		"@vitest/browser-playwright": "4.1.8",
		"@vitest/coverage-v8": "4.1.8",
		"bits-ui": "2.19.2",
		"clsx": "2.1.1",
		"cross-env": "10.1.0",
		"eslint": "10.10.0",
		"eslint-config-prettier": "10.1.8",
		"eslint-plugin-perfectionist": "5.11.1",
		"eslint-plugin-svelte": "3.23.0",
		"globals": "17.12.0",
		"playwright": "1.63.0",
		"prettier": "3.9.7",
		"prettier-plugin-svelte": "4.1.1",
		"prettier-plugin-tailwindcss": "0.8.1",
		"shadcn-svelte": "1.7.0",
		"svelte": "5.57.0",
		"svelte-check": "4.7.6",
		"tailwind-merge": "3.7.0",
		"tailwind-variants": "3.3.1",
		"tailwindcss": "4.3.3",
		"tw-animate-css": "1.4.0",
		"typescript": "6.0.3",
		"typescript-eslint": "8.70.0",
		"vite": "8.3.0",
		"vitest": "4.1.8",
		"vitest-browser-svelte": "2.1.1"
	},
	"dependencies": {
		"@capacitor/android": "8.5.2",
		"@capacitor/cli": "8.5.2",
		"@capacitor/core": "8.5.2",
		"@capacitor/device": "8.0.3",
		"@capacitor/ios": "8.5.2",
		"@capacitor/splash-screen": "8.0.2",
		"@fontsource-variable/google-sans-flex": "5.3.1",
		"appwrite": "27.0.0",
		"@sveltejs/adapter-static": "3.0.10",
		"eslint-plugin-perfectionist": "5.11.1",
		"mode-watcher": "1.1.0"
	}
}
